# 构建产物
out/
out-a16/
mic-bridge.apk
mic-bridge.apk.idsig
*.idsig

# release/ 里只留版本化的正式包（同 xiaole-ptt 仓库的做法）
!release/*.apk

# 验收音频（体积大，结论已写进 docs/）
verify.wav
spike/captured_mic.wav
out_*.log

# 本机环境与依赖
.venv/
__pycache__/
*.pyc
micbridge.keystore

# 本机临时抓取物（空目录，git 本也不跟踪）
artifacts/

# PyInstaller 产物（走 GitHub Release，不进 git）
dist/
build_tmp/
*.spec
# 例外：Windows 安装版的打包配置要入库（其余 .spec 仍忽略）
!packaging/*.spec
cap_probe.wav
