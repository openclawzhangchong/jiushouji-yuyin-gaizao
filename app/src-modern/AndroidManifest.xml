<?xml version="1.0" encoding="utf-8"?>
<!--
  modern 变体（Android 16 / API 36）专用 Manifest。
  legacy 变体仍用 app/AndroidManifest.xml，两者互不影响。
  包名 .a16 后缀：可与 legacy 并存安装，不会覆盖老用户已装的 com.zcstudy.micbridge。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zcstudy.micbridge.a16">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 11+ 息屏/后台继续采麦：必须有 microphone 类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 13+ 读共享存储音频改走 READ_MEDIA_AUDIO；旧权限只在 12 及以下生效 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_round"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">
        <activity
            android:name="com.zcstudy.micbridge.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 送话期间的 microphone 前台服务：没有它，息屏后 AudioService 会把录音判为 silenced -->
        <service
            android:name="com.zcstudy.micbridge.MicService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
